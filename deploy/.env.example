# The name clients will use, with an A record pointing at this server (for example relay.example.org).
DOMAIN=relay.example.org
# This server public IPv4 address (the TURN server must tell phones where to send calls).
PUBLIC_IP=203.0.113.10
# A long random secret shared by the relay and the TURN server. Make one with:  openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-value
