{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spike Connect",
  "version": "0.0.1",
  "identifier": "network.spike.connect",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Spike Connect", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
