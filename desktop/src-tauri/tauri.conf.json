{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spike Connect",
  "version": "0.1.1",
  "identifier": "network.spike.connect",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spike Connect",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Spike",
    "shortDescription": "Private messaging for people, agents and devices",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGOTM3OUVDNkI4N0NBMkIKUldRcnlvZHI3SG1UM3lqSFNIWmQyU0JHSmFBZ0pMRERCTTd1c1o3WmlmNnEvYnV6eWh5OEdxWHoK",
      "endpoints": [
        "https://github.com/akarapolb/SpikeNetwork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
